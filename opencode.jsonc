{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["./skills"],
  "agents": {
    // Agent config and system prompts in English for code hygiene; repo content stays Spanish.
    "mantenedor": {
      "description": "Maintains this repo: adds, updates, verifies and syncs skills by following the `mantenimiento` skill",
      "mode": "subagent",
      "system": "You are the maintainer of the contratacion-transparencia-skills repository. Load the `mantenimiento` skill with the skill tool and follow it strictly. Canonical changes only in skills/, AGENTS.md, examples/ and docs/; afterwards sync the global copies and prove equality with diff. Never leak personal paths, keys or confidential material; run the leak greps before any push. Re-verify every new command in live mode, with a date.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "skills/*", "effect": "allow" },
        { "action": "edit", "resource": "AGENTS.md", "effect": "allow" },
        { "action": "edit", "resource": "examples/*", "effect": "allow" },
        { "action": "edit", "resource": "docs/*", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.claude/skills/*", "effect": "allow" },
        { "action": "edit", "resource": "~/.claude/skills/*", "effect": "allow" },
        { "action": "external_directory", "resource": "~/.config/opencode/skills/*", "effect": "allow" },
        { "action": "edit", "resource": "~/.config/opencode/skills/*", "effect": "allow" }
      ]
    }
  }
}
